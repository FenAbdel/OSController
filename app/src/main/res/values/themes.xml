<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OSController" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Creer le composant titre par default -->
    
    <style name="DefaultTextStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TitleTextStyle" parent="DefaultTextStyle">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/poppinsbold</item>
    </style>

    <style name="FormTextStyle" parent="DefaultTextStyle">
        <item name="android:textSize">13sp</item>
    </style>
</resources>