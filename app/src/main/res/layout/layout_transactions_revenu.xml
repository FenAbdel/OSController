<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/transaction_items_depense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Contenu des transactions ici -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/transaction_titre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:text="Courses" />

        <TextView
            android:id="@+id/transaction_montant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85,50 €"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Ligne 2 : Type et Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/transaction_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-10-11"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/transaction_sep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:textSize="14sp" />
        <TextView
            android:id="@+id/transaction_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="type"
            android:textSize="14sp" />


    </LinearLayout>
</LinearLayout>
