<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Titre -->
    <TextView
        android:id="@+id/titre_depense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_page_button2"
        android:textSize="20sp"
        android:textColor="#000000"
        android:layout_gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Champ Type -->
    <EditText
        android:id="@+id/edit_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type (ex: Salaire, virement)"
        android:inputType="text"
        android:background="@drawable/edit_text_border_selector"
        android:padding="12dp"
        style="@style/FormTextStyle"
        android:layout_marginBottom="16dp"/>

    <!-- Champ Type avec Spinner -->

    <Spinner
        android:id="@+id/spinner_type_revenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@drawable/custom_spinner_background"
        android:layout_marginBottom="16dp"
        android:popupBackground="#FFFFFF"
        android:spinnerMode="dropdown"/>

    <!-- Champ Date -->
    <EditText
        android:id="@+id/edit_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Date (YYYY-MM-DD)"
        android:inputType="date"
        android:background="@drawable/edit_text_border_selector"
        android:padding="12dp"
        style="@style/FormTextStyle"
        android:layout_marginBottom="16dp"/>

    <!-- Champ Montant -->
    <EditText
        android:id="@+id/edit_montant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Montant (€)"
        android:inputType="numberDecimal"
        android:background="@drawable/edit_text_border_selector"
        android:padding="12dp"
        style="@style/FormTextStyle"
        android:layout_marginBottom="16dp"/>

    <!-- Bouton Ajouter -->
    <Button
        android:id="@+id/button_ajouter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ajouter"
        android:textStyle="bold"
        android:textSize="18sp"
        android:background="@color/green"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <!-- Bouton Annuler -->
    <Button
        android:id="@+id/button_annuler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Annuler"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@color/red"
        android:textColor="#FFFFFF"
        />
</LinearLayout>
